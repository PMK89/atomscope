                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "position": {
            "description": "3-vector",
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "title": "Position",
            "type": "array"
          },
          "uid": {
            "description": "stable id surviving re-indexing",
            "title": "Uid",
            "type": "string"
          }
        },
        "required": ["element", "position"],
        "title": "Atom",
        "type": "object"
      },
      "AtomicScalarProperty": {
