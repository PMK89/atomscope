          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["version", "ase_version"],
        "title": "HealthResponse",
        "type": "object"
      },
      "ImportPathRequest": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Format"
          },
          "path": {
            "format": "path",
            "title": "Path",
            "type": "string"
          }
        },
        "required": ["path"],
        "title": "ImportPathRequest",
        "type": "object"
      },
      "OpenProjectRequest": {
        "additionalProperties": false,
        "properties": {
