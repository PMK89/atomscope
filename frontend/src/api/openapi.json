        "properties": {
          "pbc": {
            "default": [true, true, true],
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "boolean"
              },
              {
                "type": "boolean"
              },
              {
                "type": "boolean"
              }
            ],
            "title": "Pbc",
            "type": "array"
          },
          "vectors": {
            "description": "3x3 matrix as three row vectors",
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "description": "3-vector",
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "description": "3-vector",
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              },
              {
                "description": "3-vector",
                "maxItems": 3,
                "minItems": 3,
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array"
              }
            ],
            "title": "Vectors",
            "type": "array"
          }
        },
        "required": ["vectors"],
        "title": "Cell",
        "type": "object"
      },
      "CreateProjectRequest": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "path": {
            "description": "absolute path of a new (empty or missing) directory",
            "format": "path",
            "title": "Path",
            "type": "string"
          }
        },
        "required": ["path", "name"],
        "title": "CreateProjectRequest",
        "type": "object"
      },
      "ExportRequest": {
        "additionalProperties": false,
        "properties": {
          "format": {
            "title": "Format",
            "type": "string"
          },
          "path": {
            "anyOf": [
              {
                "format": "path",
                "type": "string"
              },
              {
                "type": "null"
              }
