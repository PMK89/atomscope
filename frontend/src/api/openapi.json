            "items": {
              "description": "3-vector",
              "maxItems": 3,
              "minItems": 3,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            "title": "Values",
            "type": "array"
          }
        },
        "required": ["values", "unit"],
        "title": "AtomicVectorProperty",
        "type": "object"
      },
      "Body_import_upload_api_io_import_upload_post": {
