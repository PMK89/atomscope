            "format": "path",
            "title": "Path",
            "type": "string"
          }
        },
        "required": ["path", "manifest"],
        "title": "ProjectInfo",
        "type": "object"
      },
      "ProjectManifest": {
        "additionalProperties": false,
        "properties": {
          "calculation_ids": {
            "items": {
              "type": "string"
            },
            "title": "Calculation Ids",
            "type": "array"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "dataset_ids": {
            "items": {
              "type": "string"
            },
            "title": "Dataset Ids",
            "type": "array"
          },
          "format_version": {
            "default": 1,
            "title": "Format Version",
            "type": "integer"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "modified_at": {
            "format": "date-time",
            "title": "Modified At",
            "type": "string"
          },
          "name": {
            "default": "untitled project",
            "title": "Name",
            "type": "string"
          },
          "notes": {
            "default": "",
            "title": "Notes",
            "type": "string"
          },
          "structure_ids": {
            "items": {
              "type": "string"
            },
            "title": "Structure Ids",
            "type": "array"
          },
          "view_settings": {
            "additionalProperties": true,
            "title": "View Settings",
            "type": "object"
          }
        },
        "title": "ProjectManifest",
        "type": "object"
      },
      "Provenance": {
        "additionalProperties": false,
        "description": "Where a piece of data came from.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "notes": {
            "default": "",
            "title": "Notes",
            "type": "string"
          },
          "parents": {
            "description": "ids of parent objects",
            "items": {
              "type": "string"
            },
            "title": "Parents",
            "type": "array"
          },
          "software": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "e.g. 'CP-PAW aa467ef', 'ASE 3.26'",
            "title": "Software"
          },
          "source": {
            "description": "file path, backend id, tool name or 'user'",
            "title": "Source",
            "type": "string"
          }
        },
        "required": ["source"],
        "title": "Provenance",
        "type": "object"
      },
      "Quantity": {
        "additionalProperties": false,
        "description": "A scalar with an explicit unit.",
        "properties": {
          "unit": {
            "$ref": "#/components/schemas/Unit"
          },
          "value": {
            "title": "Value",
            "type": "number"
          }
        },
        "required": ["value", "unit"],
        "title": "Quantity",
        "type": "object"
      },
      "Residue": {
        "additionalProperties": false,
        "description": "Residue/chain information for biomolecules.",
        "properties": {
          "atom_indices": {
            "items": {
              "type": "integer"
            },
            "title": "Atom Indices",
            "type": "array"
          },
          "chain": {
            "default": "",
            "title": "Chain",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "number": {
            "title": "Number",
            "type": "integer"
          }
        },
        "required": ["name", "number", "atom_indices"],
        "title": "Residue",
        "type": "object"
      },
      "SmilesRequest": {
        "additionalProperties": false,
        "properties": {
          "add_hydrogens": {
            "default": true,
            "title": "Add Hydrogens",
            "type": "boolean"
          },
          "smiles": {
            "title": "Smiles",
            "type": "string"
          }
        },
        "required": ["smiles"],
        "title": "SmilesRequest",
        "type": "object"
      },
      "Structure": {
        "additionalProperties": false,
        "description": "The central editable object: atoms, bonds, cell and attached properties.",
        "properties": {
          "atomic_scalars": {
            "additionalProperties": {
              "$ref": "#/components/schemas/AtomicScalarProperty"
            },
            "title": "Atomic Scalars",
            "type": "object"
          },
          "atomic_vectors": {
            "additionalProperties": {
              "$ref": "#/components/schemas/AtomicVectorProperty"
            },
            "title": "Atomic Vectors",
            "type": "object"
          },
          "atoms": {
            "items": {
              "$ref": "#/components/schemas/Atom"
            },
            "title": "Atoms",
            "type": "array"
          },
          "bonds": {
            "items": {
              "$ref": "#/components/schemas/Bond"
            },
            "title": "Bonds",
            "type": "array"
          },
          "cell": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Cell"
              },
              {
                "type": "null"
              }
            ]
          },
          "charge": {
            "default": 0.0,
            "description": "total charge in e",
            "title": "Charge",
            "type": "number"
          },
          "constraints": {
            "items": {
              "discriminator": {
                "mapping": {
                  "fix_atoms": "#/components/schemas/FixAtoms",
                  "fix_bond_length": "#/components/schemas/FixBondLength",
                  "fix_cartesian": "#/components/schemas/FixCartesian"
                },
                "propertyName": "kind"
              },
              "oneOf": [
                {
                  "$ref": "#/components/schemas/FixAtoms"
                },
                {
                  "$ref": "#/components/schemas/FixCartesian"
                },
                {
                  "$ref": "#/components/schemas/FixBondLength"
                }
              ]
            },
            "title": "Constraints",
            "type": "array"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "multiplicity": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "2S+1; None = unspecified",
            "title": "Multiplicity"
          },
          "name": {
            "default": "untitled",
            "title": "Name",
            "type": "string"
          },
          "properties": {
            "additionalProperties": {
              "$ref": "#/components/schemas/Quantity"
            },
            "title": "Properties",
            "type": "object"
          },
          "provenance": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Provenance"
              },
              {
                "type": "null"
              }
            ]
          },
          "residues": {
            "items": {
              "$ref": "#/components/schemas/Residue"
            },
            "title": "Residues",
            "type": "array"
          }
        },
        "title": "Structure",
        "type": "object"
      },
      "StructureSummary": {
        "additionalProperties": false,
        "properties": {
          "formula": {
            "title": "Formula",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "n_atoms": {
            "title": "N Atoms",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "periodic": {
            "title": "Periodic",
            "type": "boolean"
          }
        },
        "required": ["id", "name", "formula", "n_atoms", "periodic"],
        "title": "StructureSummary",
        "type": "object"
      },
      "Unit": {
        "description": "Units that can appear on quantities in the data model.",
        "enum": [
          "angstrom",
          "bohr",
          "nm",
          "eV",
          "hartree",
          "kJ/mol",
          "kcal/mol",
          "rydberg",
          "eV/angstrom",
          "hartree/bohr",
          "fs",
          "atomic_time",
          "ps",
          "e",
          "muB",
          "K",
          "cm^-1",
          "debye",
          "e*angstrom",
          "",
          "e/angstrom^3",
          "e/bohr^3",
          "V",
          "hartree/e"
        ],
        "title": "Unit",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": ["loc", "msg", "type"],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Atomscope API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": ["system"]
      }
    },
    "/api/io/export": {
      "post": {
        "operationId": "export_structure_api_io_export_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Export Structure",
        "tags": ["io"]
      }
    },
    "/api/io/formats": {
      "get": {
        "operationId": "list_formats_api_io_formats_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/FormatDescription"
                  },
                  "title": "Response List Formats Api Io Formats Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Formats",
        "tags": ["io"]
      }
    },
    "/api/io/import/path": {
      "post": {
        "description": "Read a structure from a file on this machine (the backend is local-only).",
        "operationId": "import_path_api_io_import_path_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportPathRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Structure"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Import Path",
        "tags": ["io"]
      }
    },
    "/api/io/import/upload": {
      "post": {
