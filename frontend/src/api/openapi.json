            "type": "string"
          }
        },
        "required": ["a", "b"],
        "title": "FixBondLength",
        "type": "object"
      },
      "FixCartesian": {
        "additionalProperties": false,
        "description": "Fix selected Cartesian components (mask True = fixed) of one atom.",
        "properties": {
          "index": {
            "title": "Index",
            "type": "integer"
          },
          "kind": {
            "const": "fix_cartesian",
            "default": "fix_cartesian",
            "title": "Kind",
            "type": "string"
          },
          "mask": {
            "default": [true, true, true],
            "maxItems": 3,
            "minItems": 3,
            "prefixItems": [
              {
                "type": "boolean"
              },
              {
                "type": "boolean"
              },
              {
                "type": "boolean"
              }
            ],
            "title": "Mask",
            "type": "array"
          }
        },
        "required": ["index"],
        "title": "FixCartesian",
        "type": "object"
      },
      "FormatDescription": {
        "additionalProperties": false,
        "properties": {
          "can_read": {
            "title": "Can Read",
