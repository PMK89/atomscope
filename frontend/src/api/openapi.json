          },
          "can_write": {
            "title": "Can Write",
            "type": "boolean"
          },
          "description": {
            "title": "Description",
            "type": "string"
          },
          "extensions": {
            "items": {
              "type": "string"
            },
            "title": "Extensions",
            "type": "array"
          },
          "library": {
            "title": "Library",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": ["name", "extensions", "description", "can_read", "can_write", "library"],
        "title": "FormatDescription",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
